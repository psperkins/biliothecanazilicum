# Copy to .env (same folder) and fill in. .env is gitignored.

# Where to read canon from (production by default).
DRUPAL_BASE_URL=https://cloakofnazili.org

# AnythingLLM's local API.
ANYTHINGLLM_URL=http://localhost:3001

# Settings → Developer API → Generate New API Key
ANYTHINGLLM_API_KEY=

# The workspace slug (as shown in the workspace's URL).
ANYTHINGLLM_WORKSPACE=the-librarian
